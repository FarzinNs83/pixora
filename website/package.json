    "test:engine": "node scripts/image-engine-smoke.mjs",
    "test:ai": "node scripts/background-engine-smoke.mjs",
    "test:video-engine": "node scripts/video-engine-smoke.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "icons": "node scripts/build-app-icons.mjs",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "@imagemagick/magick-wasm": "0.0.43",
    "@phosphor-icons/react": "2.1.10",
    "@resvg/resvg-wasm": "2.6.2",
    "fflate": "0.8.3",
    "imagetracerjs": "1.2.6",
    "motion": "13.3.0",
    "onnxruntime-web": "1.21.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "puppeteer-core": "25.11.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
